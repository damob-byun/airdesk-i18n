msgid "Choose a file."
msgstr "ファイルを選択してください。"

msgid "Deleting…"
msgstr "削除中…"

msgid "Deleted"
msgstr "削除しました"

msgid "Deleted {count} items"
msgstr "{count} 項目を削除しました"

msgid "Duplicating…"
msgstr "複製中…"

msgid "Duplicated as {name}"
msgstr "{name} として複製しました"

msgid "Opening…"
msgstr "開いています…"

msgid "Saving…"
msgstr "保存中…"

msgid "Saved"
msgstr "保存しました"

msgid "Another file operation is running."
msgstr "別のファイル操作を実行中です。"

msgid "Line {line}/{lines}, column {column}"
msgstr "行 {line}/{lines}, 列 {column}"

msgid "The cut buffer is empty"
msgstr "切り取りバッファーは空です"

msgid "Nothing to undo"
msgstr "元に戻す操作はありません"

msgid "Nothing to redo"
msgstr "やり直す操作はありません"

msgid "Not found"
msgstr "見つかりません"

msgid "Replaced {count} occurrences"
msgstr "{count} 箇所を置換しました"

msgid "Enter a line number"
msgstr "行番号を入力してください"

msgid "Drop files on the remote computer pane to send them."
msgstr "リモートコンピューター側にドロップすると送信されます。"

msgid "Remote computer"
msgstr "リモートコンピューター"

msgid "This computer"
msgstr "このコンピューター"

msgid "Administrator permission was declined. Wake settings were not changed."
msgstr "管理者権限が拒否されたため、ウェイク設定は変更されませんでした。"

msgid "Windows is still applying the wake settings. Check again in a moment."
msgstr "Windows がウェイク設定を適用中です。しばらくしてからもう一度確認してください。"

msgid "Could not change the wake settings. Try again or enable them in Device Manager."
msgstr "ウェイク設定を変更できませんでした。もう一度試すか、デバイス マネージャーで有効にしてください。"

msgid "Administrator permission was declined. The service was not changed."
msgstr "管理者権限が拒否されたため、サービスは変更されませんでした。"

msgid "Permission was declined. Start on login was not changed."
msgstr "許可が拒否されたため、自動起動の設定は変更されませんでした。"

msgid "Could not install the AirDesk service. Try again or reinstall AirDesk."
msgstr "AirDesk サービスをインストールできませんでした。もう一度試すか、AirDesk を再インストールしてください。"

msgid "Could not remove the AirDesk service. Try again."
msgstr "AirDesk サービスを削除できませんでした。もう一度試してください。"

msgid "Could not change start on login."
msgstr "自動起動の設定を変更できませんでした。"

msgid "AirDesk service installed"
msgstr "AirDesk サービスをインストールしました"

msgid "AirDesk service removed"
msgstr "AirDesk サービスを削除しました"

msgid "Start on login turned on"
msgstr "自動起動をオンにしました"

msgid "Start on login turned off"
msgstr "自動起動をオフにしました"

msgid "Windows administrator permission was declined, so the update was not installed. AirDesk will not ask again until you choose Try again or restart AirDesk."
msgstr "Windows の管理者権限が拒否されたため、アップデートはインストールされませんでした。「再試行」を選ぶか AirDesk を再起動するまで再度確認しません。"

msgid "This computer is already online."
msgstr "このコンピューターはすでにオンラインです。"

msgid "Wake request delivered to an AirDesk device. Check the computer's status after it starts."
msgstr "AirDesk デバイスに起動要求を届けました。しばらくしてコンピューターの状態を確認してください。"

msgid "Last device activity"
msgstr "連携端末の最終アクティビティ"

msgid "Remote boot"
msgstr "リモート起動"

msgid "Unknown"
msgstr "不明"

msgid "{ext} file"
msgstr "{ext} ファイル"

msgid "{count} items"
msgstr "{count} 項目"

msgid "{files} files and {folders} folders. Total size: {size}"
msgstr "ファイル {files} 個、フォルダー {folders} 個。合計サイズ: {size}"

msgid "The remote computer blocked access to this folder. On a Mac, allow AirDesk in System Settings → Privacy & Security → Files & Folders (or Full Disk Access) on that computer."
msgstr "リモートコンピューターがこのフォルダーへのアクセスをブロックしました。Mac の場合は、そのコンピューターのシステム設定 → プライバシーとセキュリティ → ファイルとフォルダー(またはフルディスクアクセス)で AirDesk を許可してください。"

msgid "macOS blocked access to this folder. Allow AirDesk in System Settings → Privacy & Security → Files & Folders (or Full Disk Access), then refresh."
msgstr "macOS がこのフォルダーへのアクセスをブロックしました。システム設定 → プライバシーとセキュリティ → ファイルとフォルダー(またはフルディスクアクセス)で AirDesk を許可してから更新してください。"

msgid "Access to this folder was denied on this computer."
msgstr "このコンピューターでこのフォルダーへのアクセスが拒否されました。"


msgid "CCTV view"
msgstr "CCTV 表示"

msgid "Exit CCTV view"
msgstr "CCTV 表示を終了"

msgid "{count} computers"
msgstr "{count} 台のコンピューター"

