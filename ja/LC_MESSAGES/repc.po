msgid ""
msgstr ""
"Project-Id-Version: RePC\n"
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "On supported desktop builds, the MCP server uses agent-desktop (Apache License 2.0)."
msgstr "対応するデスクトップビルドでは、MCPサーバーはagent-desktop（Apache License 2.0）を使用します。"

msgid "GPU presentation"
msgstr "GPU画面出力"

msgid "GPU direct presentation"
msgstr "GPU直接出力"

msgid "Compatibility GPU copy"
msgstr "互換性GPUコピー"

msgid "Applies to the next connection. Auto prefers GPU direct presentation. Compatibility mode uses a GPU copy."
msgstr "次の接続から適用されます。自動ではGPU直接出力を優先し、互換性モードではGPUコピーを使用します。"

msgid "Saved. GPU presentation changes apply to the next connection."
msgstr "保存しました。GPU画面出力の変更は次の接続から適用されます。"

msgid "Saved. AV1 decoding applies to the next connection."
msgstr "保存しました。AV1デコードは次の接続から適用されます。"

msgid "AV1 encoding (hardware only)"
msgstr "AV1エンコード（ハードウェアのみ）"

msgid "Encodes AV1 only when this GPU has a hardware AV1 encoder and the viewer can decode AV1. Otherwise HEVC or H.264 is used."
msgstr "このGPUにハードウェアAV1エンコーダーがあり、相手がAV1をデコードできる場合のみAV1でエンコードします。それ以外はHEVCまたはH.264を使用します。"

msgid "AV1 decoding (hardware only)"
msgstr "AV1デコード（ハードウェアのみ）"

msgid "Rate control"
msgstr "ビットレート制御"

msgid "Always CBR"
msgstr "常にCBR"

msgid "Encoder-specific VBR"
msgstr "エンコーダー別VBR"

msgid "AUTO uses VBR. Select CBR or VBR if needed."
msgstr "AUTOはVBRを使用します。必要に応じてCBRまたはVBRを選択してください。"

msgid "Continue"
msgstr "続ける"

msgid "Enter your authentication code"
msgstr "認証コードを入力"

msgid "Enter the 6-digit code from your authenticator app to finish signing in."
msgstr "ログインを完了するには、認証アプリに表示される6桁のコードを入力してください。"

msgid "After 30 days without outgoing connections, confirm your password to connect from this PC again."
msgstr "このPCから他のPCへ30日間接続していません。再び接続するには、パスワードを確認してください。"

msgid "Incoming connections stay available."
msgstr "このPCへのリモート接続は引き続き利用できます。"

msgid "Verify and connect"
msgstr "認証して接続"

msgid "Sign in again"
msgstr "再度ログイン"

msgid "Restore outgoing connections"
msgstr "ほかのPCへの接続を復元"

msgid "Enter your password to reconnect from this computer. Incoming remote connections stay available."
msgstr "このコンピューターから再接続するにはパスワードを入力してください。このコンピューターへのリモート接続は維持されます。"

msgid "Restoring..."
msgstr "復元中..."

msgid "Outgoing connections restored."
msgstr "ほかのPCに再び接続できるようになりました。"

msgid "The password is incorrect."
msgstr "パスワードが正しくありません。"

msgid "Could not restore outgoing connections. Please try again."
msgstr "ほかのPCへの接続を復元できませんでした。再試行してください。"

msgid "This computer is in host-only mode after 30 days without outgoing remote use. Sign in again here to connect to other computers. Incoming connections remain available."
msgstr "30日間ほかのコンピューターに接続していないため、このコンピューターはホスト専用モードです。ほかのコンピューターに接続するには、ここで再度ログインしてください。このコンピューターへのリモート接続は引き続き利用できます。"

msgid "Current sessions"
msgstr "現在のセッション"

msgid "Connections"
msgstr "接続状況"

msgid "Tablet"
msgstr "タブレット"

msgid "No tablet selected"
msgstr "タブレットは選択されていません"

msgid "Tablet unavailable for this connection"
msgstr "この接続ではタブレットを使用できません。"

msgid "Stop sharing"
msgstr "共有を停止"

msgid "Beware of phishing"
msgstr "フィッシングにご注意ください"

msgid "Only approve people you trust. Reject unexpected remote access requests, including anyone claiming to be your bank or a public agency."
msgstr "信頼できる相手のリクエストだけを承認してください。銀行や公的機関を名乗る相手や、知らない人からの予期しないリモート接続は拒否してください。"

msgid "A user is requesting access using your AirDesk ID. If you allow it, they can view and control this computer."
msgstr "AirDesk番号への接続リクエストが届いています。許可すると、相手がこのコンピューターの画面を見て操作できるようになります。"

msgid "On this computer, press {} to end all incoming remote connections."
msgstr "このコンピューターで {} を押すと、このコンピューターへのすべてのリモート接続を終了します。"

msgid "The emergency shortcut is unavailable. Use Stop sharing below to end incoming remote connections."
msgstr "緊急終了ショートカットは利用できません。リモート接続を終了するには、下の「共有を停止」を押してください。"


msgid "Open troubleshooting"
msgstr "トラブル対処ガイドを開く"

msgid "2FA code"
msgstr "2段階認証コード"

msgid "5.1 surround"
msgstr "5.1サラウンド"

msgid "7.1 surround"
msgstr "7.1サラウンド"

msgid "7.1.4 surround"
msgstr "7.1.4サラウンド"

msgid "A fixed port is easier to allow through firewall/router rules."
msgstr "ポートを固定すると、ファイアウォールやルーターのルールで許可しやすくなります。"

msgid "A forced mode can flicker or fail if the display does not support it."
msgstr "ディスプレイが対応していないモードを強制すると、画面がちらついたり失敗したりすることがあります。"

msgid "AC3 experimental"
msgstr "AC3（実験的）"

msgid "AV1 (Exp.)"
msgstr "AV1（実験的）"

msgid "AV1 and some HEVC paths depend on newer GPU/client support."
msgstr "AV1と一部のHEVC経路は、新しいGPUとクライアントの対応が必要です。"

msgid "Absolute desktop"
msgstr "絶対座標デスクトップ"

msgid "Accepted friends can connect when sharing is enabled."
msgstr "承認済みのフレンドは、共有がオンのときに接続できます。"

msgid "Accessibility"
msgstr "アクセシビリティ"

msgid "Add Friend"
msgstr "フレンドを追加"

msgid "Add VDD"
msgstr "VDDを追加"

msgid "Adds frame delay and should stay 0 for lowest latency."
msgstr "フレーム遅延が加わるため、最小の遅延にするには0のままにしてください。"

msgid "Adds latency and is usually off for remote control."
msgstr "遅延が増えるため、リモート操作では通常オフにします。"

msgid "Advanced"
msgstr "詳細"

msgid "Advertises and discovers hosts on the local network without the backend path."
msgstr "サーバーを経由せず、ローカルネットワーク上でホストを通知・検出します。"

msgid "Allows VideoToolbox to reorder frames when it improves compression."
msgstr "圧縮効率が上がる場合に、VideoToolboxがフレームの順序を入れ替えられるようにします。"

msgid "Allows connected clients to move and click the host pointer."
msgstr "接続したクライアントがホストのポインターを動かしてクリックできるようにします。"

msgid "Allows connected clients to send gamepad/controller events."
msgstr "接続したクライアントがゲームパッドやコントローラーの入力を送信できるようにします。"

msgid "Allows connected clients to send keyboard events to the host."
msgstr "接続したクライアントがホストへキーボード入力を送信できるようにします。"

msgid "Allows gamepad/controller input from the client."
msgstr "クライアントからのゲームパッドやコントローラーの入力を許可します。"

msgid "Allows keyboard events from the client."
msgstr "クライアントからのキーボード入力を許可します。"

msgid "Allows microphone forwarding/control for sessions that need voice input."
msgstr "音声入力が必要なセッションで、マイクの転送と制御を許可します。"

msgid "Allows mouse movement, clicks, wheel, and pointer state from the client."
msgstr "クライアントからのマウスの移動、クリック、ホイール、ポインター状態の入力を許可します。"

msgid "Allows the encoder to insert filler bytes to hold a steadier bitrate."
msgstr "ビットレートをより一定に保つため、エンコーダーがフィラーバイトを挿入できるようにします。"

msgid "Allows the host to capture and stream system audio."
msgstr "ホストがシステム音声をキャプチャして配信できるようにします。"

msgid "Allows the host to send screen frames."
msgstr "ホストが画面のフレームを送信できるようにします。"

msgid "Application Audio Capture"
msgstr "アプリケーション音声のキャプチャ"

msgid "Application capture can isolate one app's sound."
msgstr "アプリケーションキャプチャを使うと、特定のアプリの音だけを取得できます。"

msgid "Application capture support depends on Windows/app behavior."
msgstr "アプリケーションキャプチャの対応状況は、Windowsやアプリの動作によって異なります。"

msgid "Applies NVIDIA profile preferences used by the host capture/encode path."
msgstr "ホストのキャプチャ・エンコード処理で使うNVIDIAプロファイルの設定を適用します。"

msgid "Applies echo cancellation when microphone and playback paths interact."
msgstr "マイクと再生の経路が干渉する場合に、エコーキャンセルを適用します。"

msgid "Audio"
msgstr "オーディオ"

msgid "Audio Bitrate"
msgstr "オーディオビットレート"

msgid "Audio Bitrate (kbps)"
msgstr "オーディオビットレート（kbps）"

msgid "Audio Capture"
msgstr "オーディオキャプチャ"

msgid "Audio Channels"
msgstr "オーディオチャンネル"

msgid "Audio Codec"
msgstr "オーディオコーデック"

msgid "Audio Device"
msgstr "オーディオデバイス"

msgid "Auto"
msgstr "自動"

msgid "Auto / native"
msgstr "自動 / ネイティブ"

msgid "Auto hardware"
msgstr "ハードウェア自動"

msgid "Auto keeps the recommended ScreenCaptureKit path."
msgstr "自動の場合は、推奨のScreenCaptureKitを使用します。"

msgid "Auto picks a codec both devices support in hardware: HEVC, then AV1, then H.264."
msgstr "自動では、両方のデバイスがハードウェアで対応するコーデックを HEVC、AV1、H.264 の順に選びます。"

msgid "Auto picks the first supported low-latency hardware path."
msgstr "自動の場合は、対応している低遅延ハードウェア経路のうち最初に見つかったものを使用します。"

msgid "Avoid sensitive names because other allowed users may see it."
msgstr "許可した他のユーザーにも表示される場合があるため、機密性のある名前は避けてください。"

msgid "Avoids typing a manual window id."
msgstr "ウィンドウIDを手入力する必要がなくなります。"

msgid "Balanced"
msgstr "バランス"

msgid "Balanced cursor"
msgstr "バランスカーソル"

msgid "Best for interactive desktop, games, and LAN sessions."
msgstr "デスクトップ操作、ゲーム、LAN接続に最適です。"

msgid "Bind IP"
msgstr "バインドIP"

msgid "Bitrate"
msgstr "ビットレート"

msgid "By signing in, you agree to the Terms of Service and Privacy Policy."
msgstr "ログインすると、利用規約とプライバシーポリシーに同意したものとみなされます。"

msgid "Can add latency and GPU work, so keep off for lowest latency."
msgstr "遅延とGPU負荷が増えることがあるため、最小の遅延にするにはオフにしてください。"

msgid "Can avoid known driver latency/capture issues."
msgstr "既知のドライバーによる遅延やキャプチャの問題を回避できます。"

msgid "Can bound bitrate spikes on simple or static content."
msgstr "単純な映像や静止した映像で、ビットレートの急増を抑えます。"

msgid "Can change texture detail and add small encoder overhead."
msgstr "質感の表現が変わり、エンコーダーの負荷がわずかに増えることがあります。"

msgid "Can conflict with local controller use if both sides interact."
msgstr "双方で同時に操作すると、ローカルのコントローラーと競合することがあります。"

msgid "Can drop stale frames sooner on unstable or high-latency networks."
msgstr "不安定または遅延の大きいネットワークで、古いフレームをより早く破棄します。"

msgid "Can hide unused desktop area."
msgstr "使用しないデスクトップ領域を隠せます。"

msgid "Can improve direct connections outside the LAN without manual router setup."
msgstr "ルーターを手動で設定しなくても、LAN外からの直接接続が成功しやすくなります。"

msgid "Can improve fullscreen OpenGL/Vulkan capture behavior."
msgstr "全画面のOpenGL/Vulkanキャプチャの動作が改善する場合があります。"

msgid "Can improve quality and temporal AQ decisions."
msgstr "画質と時間AQの判定が改善する場合があります。"

msgid "Can improve quality at a fixed bitrate."
msgstr "固定ビットレートでの画質が向上する場合があります。"

msgid "Can improve quality at the same bitrate."
msgstr "同じビットレートでの画質が向上する場合があります。"

msgid "Can improve quality in motion when lookahead is enabled."
msgstr "ルックアヘッドを有効にすると、動きの多い場面の画質が向上する場合があります。"

msgid "Can improve quality/bitrate efficiency."
msgstr "画質とビットレート効率が向上する場合があります。"

msgid "Can increase power draw, heat, and fan noise."
msgstr "消費電力、発熱、ファンの騒音が増えることがあります。"

msgid "Can interfere with local controller devices if both sides are active."
msgstr "双方が使用中の場合、ローカルのコントローラーデバイスに干渉することがあります。"

msgid "Can make bandwidth usage more predictable for testing."
msgstr "テスト時に帯域の使用量を予測しやすくなります。"

msgid "Can prevent the encoder from spending too many bits on easy scenes."
msgstr "単純な場面で、エンコーダーがビットを使いすぎるのを防ぎます。"

msgid "Can provide device-like input behavior for apps that need it."
msgstr "必要とするアプリに、実際のデバイスに近い入力動作を提供できます。"

msgid "Can reduce compression efficiency versus quality modes."
msgstr "画質優先モードに比べて、圧縮効率が下がることがあります。"

msgid "Can reduce keyframe bandwidth spikes."
msgstr "キーフレーム時の帯域の急増を抑えます。"

msgid "Can remove menu bars or unused top area."
msgstr "メニューバーや使用しない上部の領域を除外できます。"

msgid "Can slightly change microphone quality or add processing load."
msgstr "マイクの音質がわずかに変わったり、処理負荷が増えたりすることがあります。"

msgid "Cancel"
msgstr "キャンセル"

msgid "Caps how much video data the host sends per second."
msgstr "ホストが1秒あたりに送信する映像データ量の上限を設定します。"

msgid "Capture"
msgstr "キャプチャ"

msgid "Capture Source"
msgstr "キャプチャ元"

msgid "Changing it requires clients/backend metadata to use the new port."
msgstr "変更すると、クライアントとサーバー側の情報にも新しいポートを反映する必要があります。"

msgid "Chooses desktop loopback audio or Windows application audio capture."
msgstr "デスクトップのループバック音声とWindowsのアプリケーション音声キャプチャから選択します。"

msgid "Chooses the Windows screen capture backend and whether frames stay in GPU memory."
msgstr "Windowsの画面キャプチャ方式と、フレームをGPUメモリに保持するかどうかを選択します。"

msgid "Chooses the compressed video format produced by the host encoder."
msgstr "ホストのエンコーダーが出力する映像の圧縮形式を選択します。"

msgid "Chooses the compression format for host audio."
msgstr "ホスト音声の圧縮形式を選択します。"

msgid "Chooses the macOS capture backend."
msgstr "macOSのキャプチャ方式を選択します。"

msgid "Chooses the macOS hardware video encoder."
msgstr "macOSのハードウェア映像エンコーダーを選択します。"

msgid "Chooses the video compression format used by the host encoder."
msgstr "ホストのエンコーダーが使用する映像の圧縮形式を選択します。"

msgid "Chooses whether this host captures an entire display or one window. On Windows, window capture requires WGC VRAM or WGC RAM."
msgstr "このホストでディスプレイ全体をキャプチャするか、1つのウィンドウだけをキャプチャするかを選択します。Windowsでウィンドウをキャプチャするには、WGC VRAMまたはWGC RAMが必要です。"

msgid "Chooses which Windows output device is captured for host audio."
msgstr "ホスト音声としてキャプチャするWindowsの出力デバイスを選択します。"

msgid "Client"
msgstr "クライアント"

msgid "Client Input"
msgstr "クライアント入力"

msgid "Client Tier"
msgstr "クライアント階層"

msgid "Client UI language"
msgstr "クライアントUI言語"

msgid "Client tier changes require your password and current 2FA code when enabled."
msgstr "クライアント階層の変更には、パスワードと有効時の現在の2段階認証コードが必要です。"

msgid "Clients can interact with the hosted computer."
msgstr "クライアントがホストのコンピューターを操作できます。"

msgid "Clipboard file rate"
msgstr "クリップボードのファイル転送速度"

msgid "Clipboard file send rate in KB/s (0 = Auto). Auto adjusts to connection quality and reduces speed when video or the network is congested."
msgstr "クリップボードのファイル転送速度（KB/s、0 = 自動）です。自動モードは接続品質に応じて速度を調整し、映像やネットワークが混雑すると減速します。"

msgid "Close"
msgstr "閉じる"

msgid "Codec"
msgstr "コーデック"

msgid "Common Streaming"
msgstr "共通ストリーミング"

msgid "Compatibility and recovery behavior vary by decoder."
msgstr "互換性と復旧時の動作は、デコーダーによって異なります。"

msgid "Compatibility is more fragile and SDR clients may look wrong."
msgstr "互換性が低く、SDRのクライアントでは映像が正しく表示されないことがあります。"

msgid "Computer List"
msgstr "コンピューター一覧"

msgid "Confirm Trust Reset"
msgstr "信頼リセットの確認"

msgid "Connect"
msgstr "接続"

msgid "All computers"
msgstr "すべてのコンピューター"

msgid "{} active connections"
msgstr "接続 {}件"

msgid "Search computers"
msgstr "コンピューターを検索"

msgid "Clear search"
msgstr "検索をクリア"

msgid "No matching computers"
msgstr "検索結果がありません"

msgid "Try another name or clear the search."
msgstr "別の名前で検索するか、検索をクリアしてください。"

msgid "Connected"
msgstr "接続済み"

msgid "Connecting"
msgstr "接続中"

msgid "Connecting to "
msgstr "接続先: "

msgid "Consumes bandwidth and may expose local audio to the client."
msgstr "帯域を消費し、ホストの音声がクライアントに伝わる場合があります。"

msgid "Consumes more bandwidth than the default audio profile."
msgstr "既定のオーディオプロファイルより多くの帯域を消費します。"

msgid "Controller"
msgstr "コントローラー"

msgid "Controller Profile"
msgstr "コントローラープロファイル"

msgid "Controls Intel Quick Sync speed/quality behavior."
msgstr "Intel Quick Syncの速度と画質のバランスを調整します。"

msgid "Controls NVIDIA encoder speed/quality tradeoff from P1 to P7."
msgstr "NVIDIAエンコーダーの速度と画質のバランスをP1〜P7で調整します。"

msgid "Controls macOS encoder speed/quality behavior."
msgstr "macOSエンコーダーの速度と画質のバランスを調整します。"

msgid "Controls the channel layout sent by the host audio encoder."
msgstr "ホストの音声エンコーダーが送信するチャンネル構成を設定します。"

msgid "Controls which tier of computers can see/control this host through backend policy."
msgstr "サーバーのポリシーに基づき、どの階層のコンピューターがこのホストを表示・操作できるかを設定します。"

msgid "Costs more bandwidth and may reduce hardware decode compatibility."
msgstr "帯域をより多く消費し、ハードウェアデコードとの互換性が下がることがあります。"

msgid "Crop Height"
msgstr "切り抜きの高さ"

msgid "Crop Width"
msgstr "切り抜きの幅"

msgid "Crop X"
msgstr "切り抜きのX位置"

msgid "Crop Y"
msgstr "切り抜きのY位置"

msgid "Current setting: "
msgstr "現在の設定: "

msgid "Dark"
msgstr "ダーク"

msgid "Default audio output"
msgstr "既定のオーディオ出力"

msgid "Delete"
msgstr "削除"

msgid "Depends on router support and may be disabled for security policies."
msgstr "ルーターの対応が必要で、セキュリティポリシーにより無効にされている場合があります。"

msgid "Desktop Audio"
msgstr "デスクトップ音声"

msgid "Device names can change after driver or hardware changes."
msgstr "ドライバーやハードウェアを変更すると、デバイス名が変わることがあります。"

msgid "Diagnostics"
msgstr "診断"

msgid "Diagnostics and developer controls are isolated here from the normal computer list and settings flow."
msgstr "診断と開発者向け操作は、通常のコンピューター一覧や設定フローから分離されています。"

msgid "Disable for keyboard-only or view-only sessions."
msgstr "キーボードのみ、または表示専用のセッションではオフにしてください。"

msgid "Disable for view-only or mouse/controller-only sessions."
msgstr "表示専用、またはマウス・コントローラーのみのセッションではオフにしてください。"

msgid "Disable if the remote user should not control the pointer."
msgstr "リモートのユーザーにポインターを操作させたくない場合はオフにしてください。"

msgid "Disable if the session should not accept keyboard input."
msgstr "セッションでキーボード入力を受け付けない場合はオフにしてください。"

msgid "Disable only if you intentionally want the remote display mode to remain."
msgstr "リモート側のディスプレイモードをそのまま残したい場合にのみオフにしてください。"

msgid "Disabling video leaves only non-video channels active."
msgstr "映像をオフにすると、映像以外のチャンネルだけが有効になります。"

msgid "Disconnect"
msgstr "切断"

msgid "Dismiss"
msgstr "閉じる"

msgid "Review"
msgstr "確認"

msgid "Display"
msgstr "ディスプレイ"

msgid "Display Refresh Rate"
msgstr "ディスプレイ更新レート"

msgid "Display name shown in computer lists and host status."
msgstr "コンピューター一覧やホストの状態に表示される名前です。"

msgid "Double Monitor"
msgstr "デュアルモニター"

msgid "Driver profile changes are system-level and may affect other apps."
msgstr "ドライバープロファイルの変更はシステム全体に適用され、ほかのアプリにも影響する場合があります。"

msgid "E-AC3 experimental"
msgstr "E-AC3（実験的）"

msgid "Echo cancellation"
msgstr "エコーキャンセル"

msgid "Enable VDD"
msgstr "VDDを有効化"

msgid "Enables prediction tools that may improve compression on some content."
msgstr "一部のコンテンツで圧縮効率を高められる予測機能を有効にします。"

msgid "Enables the OpenGL/Vulkan-on-DXGI present preference for NVIDIA capture compatibility."
msgstr "NVIDIAのキャプチャ互換性のため、OpenGL/VulkanをDXGIのPresent方式で出力する設定を優先します。"

msgid "Encoder"
msgstr "エンコーダー"

msgid "Enforces minimum quantizer values using the H.264/HEVC fields below."
msgstr "下のH.264/HEVCの値を、最小量子化値として適用します。"

