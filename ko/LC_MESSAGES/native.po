msgid "A file transfer is already in progress"
msgstr "파일 전송이 이미 진행 중입니다"

msgid "The file list is too large"
msgstr "파일 목록이 너무 큽니다"

msgid "Only regular files and folders can be transferred"
msgstr "일반 파일과 폴더만 전송할 수 있습니다"

msgid "Up to 10,000 files and folders can be transferred"
msgstr "파일과 폴더는 10,000개까지 전송할 수 있습니다"

msgid "The source folder path changed"
msgstr "원본 폴더 경로가 변경되었습니다"

msgid "Unsupported source name"
msgstr "지원하지 않는 원본 이름입니다"

msgid "The other PC reported an invalid resume position"
msgstr "상대 PC의 이어받기 위치가 올바르지 않습니다"

msgid "Could not open the file to send"
msgstr "전송할 파일을 열 수 없습니다"

msgid "Invalid save confirmation response"
msgstr "잘못된 저장 확인 응답입니다"

msgid "File transfer cancelled"
msgstr "파일 전송이 취소되었습니다"

msgid "Invalid file save confirmation response"
msgstr "잘못된 파일 저장 확인 응답입니다"

msgid "Update the app on both PCs to the latest version to transfer folders"
msgstr "폴더 전송은 양쪽 앱을 최신 버전으로 업데이트한 뒤 사용할 수 있습니다"

msgid "More than 10 files. Compressing them into a ZIP before sending is recommended. Selected: {detail}"
msgstr "파일이 10개를 초과합니다 ({detail}개 선택됨). 압축(ZIP) 후 전송을 권장합니다."

msgid "Saved {count} file(s)/folder(s) · Downloads/AirDesk"
msgstr "파일·폴더 {count}개 저장 확인 · 다운로드/AirDesk"

msgid "Sending files…"
msgstr "파일 전송 중…"

msgid "Files sent. Older peers may not confirm save · Downloads/AirDesk"
msgstr "파일을 보냈습니다. 구버전은 저장 확인을 지원하지 않습니다 · 다운로드/AirDesk"

msgid "No file transfer started. Check that files are copied on the host."
msgstr "파일 수신이 시작되지 않았습니다. 호스트에서 파일을 복사했는지 확인해 주세요."

msgid "Requested clipboard files from the host"
msgstr "호스트에 클립보드 파일을 요청했습니다"

msgid "Could not request clipboard files"
msgstr "클립보드 파일 요청 실패"

msgid "The clipboard can only be sent to a connected remote PC"
msgstr "연결된 원격 PC에만 클립보드를 전송할 수 있습니다"

msgid "The file transfer connection was closed"
msgstr "파일 전송 연결이 종료되었습니다"

msgid "The other PC does not support folder transfers. Choose Send as ZIP."
msgstr "상대 PC가 폴더 전송을 지원하지 않습니다. ZIP으로 보내기를 선택해 주세요."

msgid "Files received. Ready to paste"
msgstr "파일 수신 완료. 붙여넣기할 수 있습니다"

msgid "Verifying received files…"
msgstr "수신 파일 검증 중…"

msgid "Receiving files…"
msgstr "파일 수신 중…"

msgid "Confirming save on remote PC… · Downloads/AirDesk"
msgstr "수신 PC에서 파일 저장 확인 중… · 다운로드/AirDesk"

msgid "Open folder"
msgstr "폴더 열기"

msgid "Screen recording requires Pro or higher"
msgstr "화면 녹화는 Pro 이상에서 사용할 수 있습니다"

msgid "Timed out checking the privacy connection"
msgstr "프라이버시 연결 상태 확인 시간 초과"

msgid "Privacy mode was turned off locally"
msgstr "프라이버시 모드가 로컬에서 해제되었습니다"

msgid "Could not apply the privacy screen cover. Windows error: {detail}"
msgstr "프라이버시 화면 가리기를 적용할 수 없습니다 (Windows 오류 {detail})"

msgid "Could not confirm that the privacy screen cover was removed"
msgstr "프라이버시 화면 가림 해제를 확인할 수 없습니다"

msgid "Could not confirm that the privacy screen cover was removed: {detail}"
msgstr "{detail}; 프라이버시 화면 가림 해제를 확인할 수 없습니다"

msgid "Privacy mode is available when sharing through the Windows service"
msgstr "프라이버시 모드는 Windows 서비스로 공유할 때 사용할 수 있습니다"

msgid "This host operating system does not support local screen privacy"
msgstr "이 호스트 운영체제는 로컬 화면 프라이버시를 지원하지 않습니다"

msgid "The privacy connection expired, so the screen cover was removed"
msgstr "프라이버시 연결이 만료되어 화면 가림을 해제했습니다"

msgid "Privacy was turned off because the screen cover could not be excluded from capture"
msgstr "화면 가림을 캡처에서 제외할 수 없어 프라이버시를 해제했습니다"

msgid "No monitor is available for the screen cover"
msgstr "화면 가리기에 사용할 모니터가 없습니다"

msgid "Could not create the screen cover window"
msgstr "화면 가림창을 만들 수 없습니다"

msgid "The login session changed, so the screen cover was removed"
msgstr "로그인 세션이 변경되어 화면 가림을 해제했습니다"

msgid "The monitor configuration changed, so the screen cover was removed"
msgstr "모니터 구성이 변경되어 화면 가림을 해제했습니다"

msgid "AirDesk privacy mode\nScreen hidden only · keyboard and mouse input allowed\nTo turn off: switch off privacy mode in the remote toolbar"
msgstr "AirDesk 프라이버시 모드\n화면만 가림 · 키보드와 마우스 입력 허용\n해제: 원격 툴바의 프라이버시 모드 끄기"

msgid "Ctrl+Alt+Del is only available on hosts owned by AirdeskService"
msgstr "Ctrl+Alt+Del은 AirdeskService 소유 호스트에서만 사용할 수 있습니다"

msgid "Ctrl+Alt+Del: The Windows software SAS policy must allow Services"
msgstr "Ctrl+Alt+Del: Windows 소프트웨어 SAS 정책에 Services 허용이 필요합니다"

msgid "Ctrl+Alt+Del is only supported on Windows service hosts"
msgstr "Ctrl+Alt+Del은 Windows 서비스 호스트에서만 지원합니다"

msgid "Allow remote file access"
msgstr "원격 파일 접근 권한을 허용해 주세요"

msgid "AirDesk could not access: {folders}. Allow these folders in System Settings → Privacy & Security → Files & Folders. Terminal access remains enabled; file browsing and commands can only use locations you allow. Full Disk Access is optional for other protected locations and must be enabled by you in System Settings."
msgstr "AirDesk가 다음 폴더에 접근할 수 없습니다: {folders}. 시스템 설정 → 개인정보 보호 및 보안 → 파일 및 폴더에서 허용해 주세요. 터미널은 계속 사용할 수 있으며, 파일 탐색과 명령은 허용된 위치에만 접근합니다. 다른 보호된 위치가 필요할 때만 전체 디스크 접근 권한을 설정에서 직접 허용해 주세요."

msgid "Files & Folders settings"
msgstr "파일 및 폴더 설정"

msgid "Later"
msgstr "나중에"

msgid "Full Disk Access settings"
msgstr "전체 디스크 접근 설정"

msgid "Permission needed for file transfer"
msgstr "파일 전송을 위한 권한이 필요합니다"

msgid "AirDesk sends and receives files through your Downloads folder (Downloads/AirDesk). Allow Downloads for AirDesk in System Settings → Privacy & Security → Files & Folders."
msgstr "AirDesk는 파일을 주고받을 때 다운로드 폴더(Downloads/AirDesk)를 사용합니다. 시스템 설정 → 개인정보 보호 및 보안 → 파일 및 폴더에서 AirDesk의 다운로드 폴더 접근을 허용해 주세요."

msgid "Open settings"
msgstr "설정 열기"

msgid "Report this code, the failed stage and the detailed reason."
msgstr "이 코드와 실패 단계, 상세 사유를 함께 전달해 주세요."

msgid "Check your sign-in details and sign in again."
msgstr "로그인 정보를 확인하고 다시 로그인해 주세요."

msgid "Check the host's access, tier and approval settings with its owner."
msgstr "호스트 소유자와 접속 권한·등급·승인 설정을 확인해 주세요."

msgid "Check the API response and connectivity to the AirDesk server, then retry."
msgstr "AirDesk 서버 연결과 API 응답을 확인한 뒤 다시 시도해 주세요."

msgid "Refresh the computer list and check that the host is online and sharing."
msgstr "컴퓨터 목록을 새로고침하고 호스트가 온라인이며 공유 중인지 확인해 주세요."

msgid "Ask the host owner to check the connection request and retry."
msgstr "호스트 소유자에게 연결 요청 확인을 요청한 뒤 다시 시도해 주세요."

msgid "Retry while the host owner is available to approve the request."
msgstr "호스트 소유자가 요청을 승인할 수 있을 때 다시 연결해 주세요."

msgid "Record the response reason and check that app and server versions are compatible."
msgstr "응답 오류 사유를 기록하고 앱·서버 버전 호환성을 확인해 주세요."

msgid "Open the email verification link on this computer using the same network, then sign in again. The link is valid for 15 minutes."
msgstr "이 컴퓨터에서 같은 네트워크를 사용해 이메일 인증 링크를 연 뒤 다시 로그인해 주세요. 링크는 15분간 유효합니다."

msgid "The verification email could not be sent. Wait a moment and sign in again."
msgstr "인증 이메일을 보내지 못했습니다. 잠시 후 다시 로그인해 주세요."

msgid "Sign in again on this computer to connect to other computers. Incoming connections remain available."
msgstr "다른 PC에 연결하려면 이 컴퓨터에서 다시 로그인해 주세요. 이 컴퓨터로 들어오는 원격 연결은 계속 사용할 수 있습니다."

msgid "Your login has expired. Please sign in again."
msgstr "로그인이 만료되었습니다. 다시 로그인해 주세요."

msgid "Check this computer's date and time, sync the system clock, then try again."
msgstr "이 컴퓨터의 날짜와 시간이 서버 기준과 맞지 않습니다. 시스템 시간을 동기화한 뒤 다시 시도해 주세요."

msgid "Check LAN discovery and STUN/NAT observations on both PCs. A STUN failure alone does not prove UDP is blocked."
msgstr "양쪽 PC의 LAN 검색과 STUN/NAT 관측값을 확인해 주세요. STUN 실패만으로 UDP 차단이 확정되지는 않습니다."

msgid "Check the host, route and app-specific UDP firewall rules on both PCs."
msgstr "호스트 상태, 연결 경로와 양쪽 PC의 AirDesk UDP 방화벽 허용 규칙을 확인해 주세요."

msgid "The direct UDP connection attempt timed out after punch probes. Retry and compare both devices' connection logs and network settings. The timeout does not identify its cause or the device responsible."
msgstr "펀칭을 포함한 직접 UDP 연결 시도가 시간 초과됐습니다. 다시 시도하고 양쪽 기기의 연결 로그와 네트워크 설정을 확인해 주세요. 시간 초과만으로 원인이나 차단 장비를 특정할 수 없습니다."

msgid "Check both peers' handshake and identity logs, then retry."
msgstr "양쪽 PC의 보안 협상·신원 확인 로그를 확인한 뒤 다시 시도해 주세요."

msgid "Verify the host identity and session authorization. Do not bypass certificate verification."
msgstr "호스트 신원과 세션 인증 정보를 확인해 주세요. 인증서 검증을 우회하지 마세요."

msgid "Check which local process owns the requested UDP port and retry with an available port."
msgstr "요청한 로컬 UDP 포트를 점유한 프로세스를 확인하고 사용 가능한 포트로 다시 시도해 주세요."

msgid "Check whether the host stopped or either network changed, then reconnect."
msgstr "호스트 종료나 양쪽 네트워크 변경 여부를 확인한 뒤 다시 연결해 주세요."

msgid "The remote session authorization expired or was revoked. Reconnect to verify access again."
msgstr "원격 세션 권한이 만료되었거나 회수되었습니다. 다시 연결해 접속 권한을 확인해 주세요."

msgid "Check the client GPU driver and renderer backend in the detailed reason."
msgstr "접속하는 PC의 GPU 드라이버와 상세 사유의 렌더러 백엔드를 확인해 주세요."

msgid "Check the client codec runtime and GPU support; try a supported codec and pixel format."
msgstr "클라이언트 코덱 런타임과 GPU 지원을 확인하고 지원되는 코덱·픽셀 형식으로 시도해 주세요."

msgid "On the host, check the selected display, screen-capture permission and capture backend."
msgstr "호스트의 선택한 디스플레이, 화면 캡처 권한과 캡처 백엔드를 확인해 주세요."

msgid "Check the host encoder runtime and driver; retry with supported resolution, codec and HDR settings."
msgstr "호스트 인코더 런타임·드라이버를 확인하고 지원되는 해상도·코덱·HDR 설정으로 시도해 주세요."

msgid "Check the host VDD driver, display topology and ADD/SELECT acknowledgement."
msgstr "호스트 VDD 드라이버, 디스플레이 구성과 ADD/SELECT 응답을 확인해 주세요."

msgid "Compare host capture/encode/send counters with client receive counters."
msgstr "호스트 캡처·인코딩·송신 카운터와 클라이언트 수신 카운터를 비교해 주세요."

msgid "Check packet loss, frame assembly and stale-frame counters on the client."
msgstr "클라이언트의 패킷 손실, 프레임 조립과 만료 프레임 카운터를 확인해 주세요."

msgid "Compare assembled and decoded frame counters and inspect the decoder error."
msgstr "조립·디코딩 프레임 카운터를 비교하고 디코더 오류를 확인해 주세요."

msgid "Check rendered-frame counters, the client window and GPU presentation errors."
msgstr "렌더링 프레임 카운터, 클라이언트 창과 GPU 화면 표시 오류를 확인해 주세요."

msgid "Check audio device selection, permissions and the capture/playback error."
msgstr "오디오 장치 선택, 권한과 캡처·재생 오류를 확인해 주세요."

msgid "Check input permissions and the host interactive input helper."
msgstr "입력 권한과 호스트의 대화형 입력 헬퍼 상태를 확인해 주세요."

msgid "Check the host ViGEmBus driver and virtual-controller connection result."
msgstr "호스트 ViGEmBus 드라이버와 가상 컨트롤러 연결 결과를 확인해 주세요."

msgid "Grant the permission named in the reason in OS settings, then retry."
msgstr "운영체제 설정에서 사유에 표시된 권한을 허용한 뒤 다시 시도해 주세요."

msgid "Check that the installed executable and runtime files are available."
msgstr "설치된 실행 파일과 런타임 파일에 접근할 수 있는지 확인해 주세요."

msgid "Collect the child process log and crash report; the last stage is only an observation."
msgstr "자식 프로세스 로그와 충돌 보고서를 수집해 주세요. 마지막 단계는 원인 확정 정보가 아닙니다."

msgid "Inspect the last stage and its counters; check the child process before retrying."
msgstr "마지막 단계와 카운터를 확인하고 자식 프로세스 상태를 점검한 뒤 다시 시도해 주세요."

msgid "Check the setting value, device support and host acknowledgement."
msgstr "설정값, 장치 지원 여부와 호스트 응답을 확인해 주세요."

msgid "Check storage space and access to the AirDesk state directory."
msgstr "저장 공간과 AirDesk 상태 디렉터리 접근 권한을 확인해 주세요."

msgid "Check the host service/process log and the failed startup component."
msgstr "호스트 서비스·프로세스 로그와 시작에 실패한 구성 요소를 확인해 주세요."

msgctxt "connection stage"
msgid "Stage not reported"
msgstr "단계 정보 없음"

msgctxt "connection stage"
msgid "Remote window launch"
msgstr "원격 창 실행"

msgctxt "connection stage"
msgid "Sign-in verification"
msgstr "로그인 인증 확인"

msgctxt "connection stage"
msgid "Host lookup"
msgstr "호스트 조회"

msgctxt "connection stage"
msgid "Network route discovery"
msgstr "네트워크 경로 탐색"

msgctxt "connection stage"
msgid "Server session authorization"
msgstr "서버 세션·접속 권한 확인"

msgctxt "connection stage"
msgid "Host approval"
msgstr "호스트 연결 승인"

msgctxt "connection stage"
msgid "Host identity verification"
msgstr "호스트 인증서·신원 확인"

msgctxt "connection stage"
msgid "Direct UDP connection / secure handshake"
msgstr "직접 UDP 연결·보안 협상"

msgctxt "connection stage"
msgid "Remote window initialization"
msgstr "원격 화면 초기화"

msgctxt "connection stage"
msgid "Video decoder initialization"
msgstr "영상 디코더 초기화"

msgctxt "connection stage"
msgid "Audio initialization"
msgstr "오디오 초기화"

msgctxt "connection stage"
msgid "Input initialization"
msgstr "입력 초기화"

msgctxt "connection stage"
msgid "Virtual display selection"
msgstr "가상 디스플레이 선택"

msgctxt "connection stage"
msgid "First video packet"
msgstr "첫 영상 패킷 수신"

msgctxt "connection stage"
msgid "Video frame reassembly"
msgstr "영상 프레임 조립"

msgctxt "connection stage"
msgid "First decoded frame"
msgstr "첫 영상 디코딩"

msgctxt "connection stage"
msgid "First frame presentation"
msgstr "첫 화면 표시"

msgctxt "connection stage"
msgid "Streaming"
msgstr "원격 연결 유지"

msgid "Sending logs requires an HTTPS API address. Check the server configuration."
msgstr "로그 전송에는 HTTPS API 주소가 필요합니다. 서버 주소를 확인해 주세요."

msgid "Check your sign-in and try again."
msgstr "로그인 상태를 확인한 후 다시 시도해 주세요."

msgid "Too many reports. Please try again later."
msgstr "전송 횟수 제한에 도달했습니다. 잠시 후 다시 시도해 주세요."

msgid "The upload is too large. Close this dialog and prepare a new report."
msgstr "전송 크기 제한을 초과했습니다. 이 창을 닫고 로그를 다시 준비해 주세요."

msgid "The server could not validate this report or consent version. Update the app and retry."
msgstr "서버가 전송 형식 또는 동의 버전을 확인하지 못했습니다. 앱을 업데이트한 후 다시 시도해 주세요."

msgid "Log submission is unavailable on this server. Try again later."
msgstr "서버의 로그 접수 기능을 현재 사용할 수 없습니다. 잠시 후 다시 시도해 주세요."

msgid "Could not confirm delivery. Check your connection and retry. The report may already have arrived."
msgstr "전송을 확인하지 못했습니다. 인터넷 연결을 확인하고 다시 시도해 주세요. 이미 접수되었을 수 있습니다."

msgid "No app logs found. Reproduce the issue and reopen this dialog."
msgstr "전송할 앱 로그를 찾지 못했습니다. 문제를 재현한 뒤 다시 열어 주세요."

msgid "Could not prepare logs. Close this dialog and try again."
msgstr "로그 준비를 시작하지 못했습니다. 이 창을 닫고 다시 시도해 주세요."

msgctxt "privacy policy URL"
msgid "https://airdesk.co.kr/en/privacy"
msgstr "https://airdesk.co.kr/ko/privacy"

msgid "Could not open the browser. Visit {url}."
msgstr "브라우저를 열 수 없습니다. {url} 를 확인해 주세요."

msgid "Keep the description within 1,000 UTF-8 bytes."
msgstr "문제 설명은 UTF-8 기준 1,000바이트 이내로 입력해 주세요."

msgid "Logs exceed the upload limit."
msgstr "로그가 전송 크기 제한을 초과했습니다."

msgid "Support data could not be saved.\n\nMove the portable file to a normal writable folder, such as Desktop, and run it again. If the problem continues, give support the exit code below."
msgstr "지원 데이터를 저장할 수 없습니다.\n\n포터블 파일을 바탕 화면 등 쓰기 가능한 일반 폴더로 옮긴 뒤 다시 실행해 주세요. 문제가 계속되면 고객 지원에 아래 종료 코드를 알려 주세요."

msgid "AirDesk Support is already running from this folder.\n\nReturn to its open window. To restart, exit the existing program from that window before running it again."
msgstr "이 폴더의 AirDesk Support가 이미 실행 중입니다.\n\n열려 있는 AirDesk Support 창으로 돌아가세요. 다시 시작하려면 기존 창에서 프로그램을 종료한 뒤 실행해 주세요."

msgid "AirDesk Support encountered an unexpected error.\n\nClose this window and run AirDesk Support again. If the problem continues, give support the exit code below."
msgstr "AirDesk Support에 예기치 않은 오류가 발생했습니다.\n\n이 창을 닫고 AirDesk Support를 다시 실행해 주세요. 문제가 계속되면 고객 지원에 아래 종료 코드를 알려 주세요."

msgid "AirDesk Support could not start.\n\nClose this window, download the portable file again from the official website, and run it. If the problem continues, give support the exit code below."
msgstr "AirDesk Support를 시작하지 못했습니다.\n\n창을 닫고 공식 홈페이지에서 포터블 파일을 다시 다운로드한 뒤 실행해 주세요. 문제가 계속되면 고객 지원에 아래 종료 코드를 알려 주세요."

msgid "Exit code: {code}"
msgstr "종료 코드: {code}"

msgid "The connection to the host has ended"
msgstr "호스트와의 연결이 종료되었습니다"

msgid "Product feature approval is turned off."
msgstr "제품 기능 승인이 꺼져 있습니다."

msgid "Ad · {sponsor}"
msgstr "광고 · {sponsor}"

msgid "Learn more  ↗"
msgstr "자세히 보기  ↗"

msgid "AirDesk · Ad"
msgstr "AirDesk · 광고"

msgid "Enter the 9-digit AirDesk number."
msgstr "9자리 AirDesk 번호를 입력하세요."

msgid "The number was not found or you do not have permission to connect."
msgstr "번호를 찾을 수 없거나 연결 권한이 없습니다."

msgid "Computer not found."
msgstr "컴퓨터를 찾을 수 없습니다."

msgid "The host cannot send video at this frame rate; keeping the current frame rate"
msgstr "호스트가 이 FPS로 영상을 보낼 수 없어 현재 FPS를 유지합니다"

msgid "The host cannot send video at the requested frame rate; using a lower frame rate"
msgstr "호스트가 요청한 FPS로 영상을 보낼 수 없어 더 낮은 FPS로 전송합니다"

msgid "This frame rate requires Pro for every viewer; keeping the current frame rate"
msgstr "이 FPS는 모든 시청자가 Pro여야 사용할 수 있어 현재 FPS를 유지합니다"

msgid "Allow AirDesk"
msgstr "AirDesk 허용"

msgid "Drag AirDesk into the list"
msgstr "AirDesk를 목록으로 끌어다 놓으세요"

msgid "Drop the icon on the app list in System Settings, then turn its switch on."
msgstr "아이콘을 시스템 설정의 앱 목록에 놓은 뒤 스위치를 켜 주세요."

msgid "More options"
msgstr "추가 메뉴"

msgid "Auto picks a codec both devices support in hardware: HEVC, then AV1, then H.264."
msgstr "자동은 두 기기가 모두 하드웨어로 지원하는 코덱을 HEVC → AV1 → H.264 순으로 고릅니다."

msgctxt "video codec"
msgid "Auto"
msgstr "자동"

msgid "Off: display refresh must be at least 2x the stream FPS"
msgstr "꺼짐: 모니터 주사율이 스트림 FPS의 2배 이상이어야 합니다"


msgid "Off: video is larger than 1080p"
msgstr "꺼짐: 영상이 1080p보다 큽니다"

msgid "Off: needs 8-bit SDR video"
msgstr "꺼짐: 8-bit SDR 영상이 필요합니다"

msgid "Off: stream FPS must be 30-120"
msgstr "꺼짐: 스트림 FPS는 30~120이어야 합니다"

msgid "Off: display clock unavailable"
msgstr "꺼짐: 디스플레이 클럭을 사용할 수 없습니다"

msgid "The remote PC is switching to the signed-in desktop. Reconnecting..."
msgstr "원격 PC가 로그인된 바탕화면으로 전환 중입니다. 다시 연결하는 중..."

msgid "Up to 4× stream FPS"
msgstr "스트림 FPS의 최대 4배"

msgid "4K or lower · 8-bit SDR"
msgstr "4K 이하 · 8비트 SDR"

msgid "Off: video is larger than 4K"
msgstr "꺼짐: 영상이 4K보다 큽니다"

msgid "Uses LS1 until the driver accepts it"
msgstr "LS1 사용 중 (드라이버가 수락하면 전환)"

msgid "Not allowed on this computer:"
msgstr "이 컴퓨터에서 허용되지 않음:"

msgid "keyboard and mouse"
msgstr "키보드·마우스"

msgid "audio"
msgstr "오디오"

msgid "clipboard"
msgstr "클립보드"

msgid "file transfer"
msgstr "파일 전송"

msgid "Some items could not be deleted. Refresh to see what remains."
msgstr "일부 항목을 삭제하지 못했습니다. 새로 고쳐 남은 항목을 확인하세요."

msgid "The item could not be deleted. It may be open in another program."
msgstr "항목을 삭제하지 못했습니다. 다른 프로그램에서 열려 있을 수 있습니다."

msgid "This folder has too many items for this action."
msgstr "이 작업을 하기에는 폴더의 항목이 너무 많습니다."

msgid "Update AirDesk on the host to use this action."
msgstr "이 기능을 쓰려면 호스트의 AirDesk를 업데이트하세요."

msgid "This file is not text and cannot be edited."
msgstr "텍스트 파일이 아니라서 편집할 수 없습니다."

msgid "This file's text encoding is not supported."
msgstr "이 파일의 문자 인코딩은 지원하지 않습니다."

msgid "Files larger than 64 MiB cannot be edited."
msgstr "64 MiB보다 큰 파일은 편집할 수 없습니다."

msgid "Some characters cannot be saved in this file's encoding."
msgstr "일부 문자는 이 파일의 인코딩으로 저장할 수 없습니다."

msgid "Choose a file."
msgstr "파일을 선택하세요."

msgid "Deleting…"
msgstr "삭제 중…"

msgid "Deleted"
msgstr "삭제했습니다"

msgid "Deleted {count} items"
msgstr "항목 {count}개를 삭제했습니다"

msgid "Duplicating…"
msgstr "복제 중…"

msgid "Duplicated as {name}"
msgstr "{name}(으)로 복제했습니다"

msgid "Opening…"
msgstr "여는 중…"

msgid "Saving…"
msgstr "저장 중…"

msgid "Saved"
msgstr "저장했습니다"

msgid "Another file operation is running."
msgstr "다른 파일 작업이 진행 중입니다."

msgid "Line {line}/{lines}, column {column}"
msgstr "줄 {line}/{lines}, 열 {column}"

msgid "The cut buffer is empty"
msgstr "잘라낸 내용이 없습니다"

msgid "Nothing to undo"
msgstr "실행 취소할 내용이 없습니다"

msgid "Nothing to redo"
msgstr "다시 실행할 내용이 없습니다"

msgid "Not found"
msgstr "찾을 수 없습니다"

msgid "Replaced {count} occurrences"
msgstr "{count}곳을 바꿨습니다"

msgid "Enter a line number"
msgstr "줄 번호를 입력하세요"

msgid "Drop files on the remote computer pane to send them."
msgstr "파일을 원격 컴퓨터 쪽에 놓으면 전송됩니다."

msgid "Remote computer"
msgstr "원격 컴퓨터"

msgid "This computer"
msgstr "이 컴퓨터"

msgid "Administrator permission was declined. Wake settings were not changed."
msgstr "관리자 권한 요청을 거절해 원격 부팅 설정을 바꾸지 않았습니다."

msgid "Windows is still applying the wake settings. Check again in a moment."
msgstr "Windows가 아직 원격 부팅 설정을 적용하고 있습니다. 잠시 후 다시 확인하세요."

msgid "Could not change the wake settings. Try again or enable them in Device Manager."
msgstr "원격 부팅 설정을 바꾸지 못했습니다. 다시 시도하거나 장치 관리자에서 직접 켜세요."

msgid "Administrator permission was declined. The service was not changed."
msgstr "관리자 권한 요청을 거절해 서비스를 변경하지 않았습니다."

msgid "Permission was declined. Start on login was not changed."
msgstr "권한 요청을 거절해 자동 시작 설정을 바꾸지 않았습니다."

msgid "Could not install the AirDesk service. Try again or reinstall AirDesk."
msgstr "AirDesk 서비스를 설치하지 못했습니다. 다시 시도하거나 AirDesk를 다시 설치하세요."

msgid "Could not remove the AirDesk service. Try again."
msgstr "AirDesk 서비스를 제거하지 못했습니다. 다시 시도하세요."

msgid "Could not change start on login."
msgstr "자동 시작 설정을 바꾸지 못했습니다."

msgid "AirDesk service installed"
msgstr "AirDesk 서비스를 설치했습니다"

msgid "AirDesk service removed"
msgstr "AirDesk 서비스를 제거했습니다"

msgid "Start on login turned on"
msgstr "자동 시작을 켰습니다"

msgid "Start on login turned off"
msgstr "자동 시작을 껐습니다"

msgid "Windows administrator permission was declined, so the update was not installed. AirDesk will not ask again until you choose Try again or restart AirDesk."
msgstr "Windows 관리자 권한 요청을 거절해 업데이트를 설치하지 않았습니다. 다시 시도를 누르거나 AirDesk를 다시 시작하기 전까지는 다시 묻지 않습니다."

msgid "This computer is already online."
msgstr "이 컴퓨터는 이미 온라인 상태입니다."

msgid "Wake request delivered to an AirDesk device. Check the computer's status after it starts."
msgstr "AirDesk 기기에 켜기 요청을 전달했습니다. 잠시 후 컴퓨터의 상태를 확인하세요."

msgid "Last device activity"
msgstr "연결 기기 마지막 활동"

msgid "Remote boot"
msgstr "원격 부팅"

msgid "Unknown"
msgstr "확인 불가"

msgid "{ext} file"
msgstr "{ext} 파일"

msgid "{count} items"
msgstr "{count}개 항목"

msgid "{files} files and {folders} folders. Total size: {size}"
msgstr "파일 {files}개, 폴더 {folders}개. 총 크기: {size}"
