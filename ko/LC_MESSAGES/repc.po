msgid "Refresh Perms"
msgstr "권한 새로고침"

msgid "Refresh to find your computers and computers shared by friends."
msgstr "새로고침하면 내 컴퓨터와 친구가 공유한 컴퓨터를 찾습니다."

msgid "Refreshes intra-coded regions gradually instead of relying only on full keyframes."
msgstr "전체 키프레임에만 의존하지 않고 인트라 코딩 영역을 조금씩 갱신합니다."

msgid "Refreshing computers..."
msgstr "컴퓨터 목록을 새로고침하고 있습니다…"

msgid "Relative game"
msgstr "상대 좌표 게임"

msgid "Remote Desktop"
msgstr "원격 데스크톱"

msgid "Remote Session"
msgstr "원격 세션"

msgid "Remote Terminal"
msgstr "원격 터미널"

msgid "Remote Printer"
msgstr "원격 프린터"

