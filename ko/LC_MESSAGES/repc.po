msgid "Retry"
msgstr "다시 시도"

msgid "Reverse scroll"
msgstr "스크롤 반전"

msgid "SESSION ON"
msgstr "세션 켜짐"

msgid "Screen Recording"
msgstr "화면 기록"

msgid "Search computers..."
msgstr "컴퓨터 검색..."

msgid "Select Off to stop hosting."
msgstr "끄면 호스팅을 중지합니다."

msgid "Select On to register and start hosting."
msgstr "켜면 컴퓨터를 등록하고 호스팅을 시작합니다."

msgid "Selects the hardware encoder family used by the host."
msgstr "호스트가 사용할 하드웨어 인코더 계열을 선택합니다."

msgid "Selects the app window to capture. Refresh after windows open, close, or rename."
msgstr "캡처할 앱 창을 선택합니다. 창이 열리거나 닫히거나 이름이 바뀐 뒤에는 새로고침하세요."

msgid "Session"
msgstr "세션"

msgid "Session Active"
msgstr "세션 활성"

msgid "Session Controls"
msgstr "세션 제어"

msgid "Sets how many video frames the host tries to capture and send per second."
msgstr "호스트가 초당 캡처해 보낼 영상 프레임 수를 정합니다."

msgid "Sets the encoder rate-control buffer size as a percentage of the target bitrate."
msgstr "인코더 비트레이트 제어 버퍼의 크기를 목표 비트레이트의 백분율로 정합니다."

msgid "Sets the frame size sent by the host when a client connects."
msgstr "클라이언트가 연결될 때 호스트가 보낼 화면 크기를 정합니다."

msgid "Sets the target audio bitrate when the selected codec uses compression."
msgstr "선택한 코덱이 압축을 사용하는 경우의 목표 오디오 비트레이트를 정합니다."

msgid "Settings"
msgstr "설정"

